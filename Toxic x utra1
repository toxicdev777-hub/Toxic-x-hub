local tabButtonRefs = {}

local function setActiveTab(tabName)
    for name, btn in pairs(tabButtonRefs) do
        btn.BackgroundColor3 = (name == tabName) and Color3.fromRGB(0, 110, 70) or Color3.fromRGB(35, 35, 35)
    end
end

local function loadTab(tabName)
    for _, child in ipairs(ContentFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local items = tabs[tabName]
    if not items then return end

    for i, item in ipairs(items) do
        createToggleItem(i, item)
    end

    ContentFrame.CanvasSize = UDim2.new(0, 0, 0, #items * 42 + 16)
    setActiveTab(tabName)
end

