            -- Posiciona o dropdown na tela com base na posição absoluta do botão
            local absPos = selBtn.AbsolutePosition
            local absSize = selBtn.AbsoluteSize
            dropFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
        end
        local optCount = #options
        TweenService:Create(dropFrame, TweenInfo.new(0.2), {
            Size = isOpen and UDim2.new(0, 150, 0, optCount * 28) or UDim2.new(0, 150, 0, 0)
        }):Play()
    end)

    return row, selBtn, dropFrame
end

