local isOpen = false
local isAnimating = false

local function setOpen(state)
    if isAnimating or state == isOpen then return end
    isAnimating = true
    isOpen = state

    if state then
        TabButtons.Visible = true
        ContentFrame.Visible = true
        Indicator.Text = "▴"
    end

    local targetSize = state and FULL_SIZE or COLLAPSED_SIZE
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.28, Enum.EasingStyle.Quad, state and Enum.EasingDirection.Out or Enum.EasingDirection.In), {Size = targetSize})
    tween:Play()
    tween.Completed:Connect(function()
        if not state then
            TabButtons.Visible = false
            ContentFrame.Visible = false
            Indicator.Text = "▾"
        end
        isAnimating = false
    end)
end

local dragging = false
local dragStart, startPos
local DRAG_THRESHOLD = 6

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local moved = math.abs(delta.X) + math.abs(delta.Y)
        dragging = false
        if moved < DRAG_THRESHOLD then
            setOpen(not isOpen)
        end
    end
end)

